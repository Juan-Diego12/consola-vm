<mxfile host="app.diagrams.net"><diagram id="escenario" name="Escenario"><mxGraphModel dx="1700" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Escenario de aplicación: Nota Parcial 2 · Consola de automatización de servicios&lt;/b&gt;" style="text;html=1;fontSize=18;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Router Wi-Fi doméstico (red local 192.168.20.0/24)&lt;/b&gt;&lt;br&gt;Servidor DHCP: asigna la IP del equipo anfitrión y de cada VM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#333333;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1180" y="60" width="480" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Equipo anfitrión: Windows 11 (DESKTOP-51D3UD4) · Wi-Fi Intel(R) Wireless-AC 9462 · IP por DHCP (192.168.20.x)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#333333;fontColor=#000000;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="1660" height="880" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Navegador web (Chrome)&lt;/b&gt;&lt;br&gt;http://127.0.0.1:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="200" width="340" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Consola de automatización (aplicación web en Go)&lt;/b&gt;&lt;br&gt;• Preparación del sistema&lt;br&gt;• Gestión de usuarios&lt;br&gt;• Gestión de servicios (systemd)&lt;br&gt;• Balanceador de carga (HAProxy)&lt;br&gt;Validación de entradas (navegador y servidor)&lt;br&gt;Registro técnico de cada operación (logs/)&lt;br&gt;Llaves ed25519 generadas (llaves/)&lt;br&gt;Recursos: catálogo de libros y fechahora.sh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="340" height="200" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;VBoxManage (Guest Additions)&lt;/b&gt;&lt;br&gt;guestcontrol: arranque inicial · guestproperty: IP de la VM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="540" width="340" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Cliente OpenSSH (ssh / scp)&lt;/b&gt;&lt;br&gt;BatchMode=yes: con llaves, sin pedir contraseña" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="340" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Flujo general de la automatización&lt;/b&gt;&lt;br&gt;1. El usuario completa el formulario del módulo.&lt;br&gt;2. La consola valida los datos (navegador y servidor).&lt;br&gt;3. Arranque inicial: con Guest Additions se instala la llave pública de root y se desactiva el acceso por contraseña.&lt;br&gt;4. Cada operación se ejecuta por SSH como root, de forma no interactiva (comandos, scp, systemctl, apt-get, haproxy).&lt;br&gt;5. La consola muestra el resultado, el detalle de cada paso y guarda el log técnico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="50" y="750" width="340" height="250" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Oracle VirtualBox 7.1.6 · adaptador de red de cada VM en modo puente sobre la tarjeta Wi-Fi&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="1240" height="830" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;NP2-Base (VM de pruebas)&lt;/b&gt;&lt;br&gt;Debian GNU/Linux 13.7.0, modo texto&lt;br&gt;1024 MB RAM · 2 CPU&lt;br&gt;enp0s3 (puente) · 192.168.20.27&lt;br&gt;OpenSSH server, puerto 22&lt;br&gt;Guest Additions instaladas&lt;br&gt;Disco: NP2-Base.vdi (20 GB, normal)&lt;br&gt;Instantánea: base-limpia&lt;br&gt;Servicios desplegados por la consola: catalogo (:8000) y fechahora" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#333333;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="440" y="240" width="290" height="240" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;NP2-HAProxy (balanceador)&lt;/b&gt;&lt;br&gt;Debian GNU/Linux 13.7.0, modo texto&lt;br&gt;1024 MB RAM&lt;br&gt;enp0s3 (puente) · 192.168.20.29&lt;br&gt;OpenSSH server, puerto 22&lt;br&gt;Guest Additions instaladas&lt;br&gt;HAProxy: frontend :80, round robin&lt;br&gt;Disco: NP2-HAProxy.vdi (clon, 20 GB)&lt;br&gt;Instantánea: haproxy-limpio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#333333;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="745" y="240" width="290" height="240" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;NP2-Backend1&lt;/b&gt;&lt;br&gt;Debian GNU/Linux 13.7.0, modo texto&lt;br&gt;512 MB RAM&lt;br&gt;enp0s3 (puente) · 192.168.20.32&lt;br&gt;Catálogo de libros como servicio :8000&lt;br&gt;hostname: np2-backend1&lt;br&gt;Disco diferencial sobre el disco multiconexión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#333333;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1050" y="240" width="290" height="200" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;NP2-Backend2&lt;/b&gt;&lt;br&gt;Debian GNU/Linux 13.7.0, modo texto&lt;br&gt;512 MB RAM&lt;br&gt;enp0s3 (puente) · 192.168.20.31&lt;br&gt;Catálogo de libros como servicio :8000&lt;br&gt;hostname: np2-backend2&lt;br&gt;Disco diferencial sobre el disco multiconexión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#333333;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1355" y="240" width="290" height="200" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Disco multiconexión NP2-Backend-Plantilla.vdi (20 GB, multiattach)&lt;/b&gt;&lt;br&gt;Debian 13.7.0 + /opt/catalogo + catalogo.service habilitado&lt;br&gt;/etc/machine-id vacío: cada VM genera el suyo y recibe su propia IP" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F2F2F2;strokeColor=#333333;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="600" width="480" height="120" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Comunicación entre el anfitrión y las VMs&lt;/b&gt;&lt;br&gt;1) Arranque inicial: VBoxManage guestcontrol (Guest Additions) con la contraseña de root, solo para instalar la llave pública de root.&lt;br&gt;2) Después, únicamente SSH con llaves (ssh/scp al puerto 22 como root).&lt;br&gt;3) La IP de cada VM se consulta con VBoxManage guestproperty (/VirtualBox/GuestInfo/Net/0/V4/IP).&lt;br&gt;4) Las IP las asigna el DHCP del router y pueden cambiar entre sesiones (en la sesión de los videos, NP2-Base tuvo 192.168.20.34)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;" vertex="1" parent="1"><mxGeometry x="440" y="840" width="600" height="165" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Clientes del balanceador&lt;/b&gt;&lt;br&gt;Navegador del anfitrión o cualquier equipo de la red → http://IP-de-NP2-HAProxy (puerto 80)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;dashed=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1110" y="780" width="480" height="90" as="geometry"/></mxCell><mxCell id="c18" value="HTTP (localhost:8080)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="guestcontrol (arranque inicial)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="SSH :22 con llave de root" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="SSH :22 con llave de root" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="HTTP :8000 (round robin)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="HTTP :8000 (round robin)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="HTTP :80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="Adaptador puente: cada VM obtiene su IP del router" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;fontColor=#000000;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>